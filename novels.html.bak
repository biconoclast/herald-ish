      rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous">
  </head>
  <body style="background-color: #a6b4a7;">
    <nav class="navbar navbar-expand-md">
      <div class="container-fluid"> <a class="navbar-brand fs-1" href="index.html"><img

            src="mnibanner.jpg" alt="Home" class="d-inline-block" height="70"><i>
            Herald-ish</i></a> <button class="navbar-toggler" type="button" data-bs-toggle="collapse"

          data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false"

          aria-label="Toggle navigation"> <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="nav justify-content-end fs-2">
