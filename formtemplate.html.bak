<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="content-type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Form Template</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"

      rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"

      crossorigin="anonymous">
    .form-control:focus {box-shadow: none;}
  </head>
  <body style="background-color: #a6b4a7;">
    <nav class="navbar navbar-expand-md">
      <div class="container-fluid"> <a class="navbar-brand fs-1" href="#"><img

            src="mnibanner.jpg" alt="Home" class="d-inline-block" height="70"><i>
            Herald-ish</i></a> <button class="navbar-toggler" type="button" data-bs-toggle="collapse"

          data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false"

          aria-label="Toggle navigation"> <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="nav justify-content-end fs-2">
            <ul class="navbar-nav">
              <li class="nav-item"> <a class="nav-link" href="services.html">Services</a>
              </li>
              <li class="nav-item"> <a class="nav-link" href="editorial.html">Editorial</a>
              </li>
              <li class="nav-item"> <a class="nav-link" href="novels.html">Novels</a>
              </li>
              <li class="nav-item"> <a class="nav-link" href="art.html">Art</a>
              </li>
              <li class="nav-item"> <a class="nav-link" href="#">About</a> </li>
            </ul>
          </ul>
        </div>
      </div>
    </nav>
    <table style="width: 98%;" align="center" cellpadding="10" border="0">
      <tbody>
        <tr>
          <td>
            <div class="card" style="background-color: rgba(255, 255, 255, 0.65);">
              <div class="card-body">
                <div class="container-md">
                  <form>
                    <h1 class="display-3" align="center">Service Inquiry Form</h1>
                    <div class="row g-3">
                      <div class="col-md-6 col-lg-4"> <label for="Name" class="form-label">Your
                          Name</label> <input class="form-control" id="Name" aria-describedby="Name"

                          name="Name" required="" type="text"></div>
                      <div class="col-md-6 col-lg-4"> <label for="Email" class="form-label">E-mail
                          Address</label> <input class="form-control" id="Email"

                          aria-describedby="Email" name="Email" required="" type="email">
                      </div>
                      <div class="col-md-6 col-lg-4"> <label for="Service" class="form-label">Select
                          Service</label>
                        <select class="form-select" id="Service" aria-describedby="Service"

                          name="service" required="">
                          <option selected="selected">Please select</option>
                          <option value="1">Ten-Page Trial</option>
                          <option value="2">Book Coaching</option>
                          <option value="3">Manuscript Evaluation</option>
                          <option value="4">Developmental Edit</option>
                          <option value="5">Graphic Novel Script Edit</option>
                          <option value="6">Redlining</option>
                          <option value="7">Sensitivity Reading</option>
                        </select>
                      </div>
                      <div class="card">
                        <div class="card-body">
                          <h6 class="card-title" align="center">About Your
                            Project</h6>
                          <div class="row g-3">
                            <div class="col-md-6 col-lg-4"> <label for="Title"

                                class="form-label">Title</label> <input class="form-control"

                                id="Title" aria-describedby="Title" name="Title"

                                placeholder="Undecided" type="text"></div>
                            <div class="col-md-6 col-lg-4"> <label for="WordCount"

                                class="form-label">Word Count</label> <input class="form-control"

                                id="WordCount" aria-describedby="WordCount" name="WordCount"

                                type="number"></div>
                            <div class="col-md-6 col-lg-4"> <label for="Genre"

                                class="form-label">Genre</label>
                              <select class="form-select" aria-label="Select" id="Genre"

                                aria-describedby="Genre" name="Genre">
                                <option selected="selected">Be aware I
                                  specialize in Adult SFF</option>
                                <option value="1">Adult Fantasy</option>
                                <option value="2">Adult Science Fiction</option>
                                <option value="3">Fantasy Graphic Novel</option>
                                <option value="4">SciFi Graphic Novel</option>
                                <option value="5">YA Fantasy</option>
                                <option value="6">YA Science Fiction</option>
                                <option value="7">Other - We can still talk
                                  about it</option>
                              </select>
                            </div>
                            <div class="col-12"> <label for="Synopsis" class="form-label">Synopsis</label>
                              <textarea class="form-control" name="Synopsis" id="Synopsis"

rows="3" placeholder="Just one to three paragraphs explaining the story. It's okay if it's not polished; we can work on it."></textarea>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-6"> <label for="Goals" class="form-label">Your
                          Goals for this Project</label> <textarea class="form-control"

name="Goals" id="Goals" rows="4" placeholder="What about this project brings you joy? Tell me your publishing goals, your vision for the story, the things you really want to pull off, such as a theme, arc, or plot-twist."></textarea>
                      </div>
                      <div class="col-lg-6"> <label for="Problems" class="form-label">Your
                          Difficulties with this Project</label> <textarea class="form-control"

name="Problems" id="Problems" rows="4" placeholder="What about this project is giving you grief? Tell me your troubles, whether it's a specific feeling that something's not clicking, or generalized anxiety after rejections. Tell me any feedback that's been bothering you, or an issue you agree with but don't know how to solve."></textarea>
                      </div>
                    </div>
                  </form>
                </div>
              </div>
              <button type="submit" class="btn btn-secondary"> Submit for Quote
                and Availability </button> </div>
          </td>
        </tr>
      </tbody>
    </table>
    <footer class="position-sticky-bottom">
      <div class="container-fluid" style="background-color: rgba(0, 0, 0, 0.65); padding-top: 6px; padding-bottom: 6px;">
        <p align="center"> <img src="emailgreen.svg" alt="Email" height="40"> <a

            href="https://bsky.app/profile/biconoclast.bsky.social"><img src="blueskygreen.png"

              alt="Bluesky" height="40"></a> <a href="https://www.instagram.com/heraldishstudio/"><img

              src="instagramgreen.svg" alt="Instagram" height="40"></a> </p>
        <p style="color: rgba(255, 255, 255, 1.00)" align="center"> Kestrel
          Craig 2026</p>
      </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"

integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"

crossorigin="anonymous"></script>
  </body>
</html>
